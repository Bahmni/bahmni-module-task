<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.openmrs.module.task.domain">

    <class name="org.bahmni.module.task.api.domain.Task" table="service_task">
        <id name="taskId" type="java.lang.Integer" column="service_task_id">
            <generator class="native">
                <param name="sequence">service_task_id_seq</param>
            </generator>
        </id>
        <many-to-one name="taskCode"  class="org.openmrs.Concept" column="task_code" not-null="true" />
        <many-to-one name="businessStatus"  class="org.openmrs.Concept" column="business_status" not-null="false" />
        <property name="status" column="status" length="20" not-null="true">
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">org.bahmni.module.task.api.domain.Task$TaskStatus</param>
                <param name="useNamed">true</param>
            </type>
        </property>
        <property name="intent" column="intent" length="20" not-null="true">
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">org.bahmni.module.task.api.domain.Task$Intent</param>
                <param name="useNamed">true</param>
            </type>
        </property>
        <property name="priority" column="priority" length="20" not-null="true">
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">org.bahmni.module.task.api.domain.Task$Priority</param>
                <param name="useNamed">true</param>
            </type>
        </property>
        <many-to-one name="patient" class="org.openmrs.Patient" column="patient_id" not-null="false" />
        <property name="dateStarted" type="java.util.Date" column="date_started" length="19" />
        <property name="dateEnded" type="java.util.Date" column="date_ended" not-null="false" length="19" />
        <many-to-one name="location" class="org.openmrs.Location" column="location_id" />
        <property name="description" type="java.lang.String" column="description" length="1024"/>
        <many-to-one name="encounter" class="org.openmrs.Encounter" column="encounter_id"/>
        <many-to-one name="order" class="org.openmrs.Order"  column="order_id"/>
        <many-to-one name="partOf" class="org.bahmni.module.task.api.domain.Task" column="part_of" />
        <set name="subTasks" inverse="true" cascade="all" lazy="true">
            <key column="part_of" />
            <one-to-many class="org.bahmni.module.task.api.domain.Task" />
        </set>
        <many-to-one name="owner" class="org.openmrs.Provider" column="owner_id" />
        <set name="inputs" inverse="true" cascade="all-delete-orphan" lazy="true">
            <key column="service_task_id"/>
            <one-to-many class="org.bahmni.module.task.api.domain.TaskInput"/>
        </set>
        <property name="uuid" type="java.lang.String" column="uuid" length="38" unique="true" />

        <many-to-one name="creator" class="org.openmrs.User" not-null="true" column="creator"/>
        <property name="dateCreated" type="java.util.Date" column="date_created" not-null="true" length="19" />
        <many-to-one name="voidedBy" class="org.openmrs.User" column="voided_by" />
        <property name="voided" type="java.lang.Boolean" column="voided" length="1" not-null="true" />
        <property name="dateVoided" type="java.util.Date" column="date_voided" length="19" />
        <property name="voidReason" type="java.lang.String" column="void_reason" length="255" />
        <many-to-one name="changedBy" class="org.openmrs.User" column="changed_by"/>
        <property name="dateChanged" type="java.util.Date" column="date_changed" length="19" />
    </class>

</hibernate-mapping>
