<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create_service_task_table_202526121900" author="Angshu">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="service_task"/>
            </not>
        </preConditions>
        <createTable tableName="service_task">
            <column name="service_task_id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_service_task"/>
            </column>
            <column name="task_code" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="intent" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="priority" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="patient_id" type="INT"/>
            <column name="date_started" type="datetime"/>
            <column name="date_ended" type="datetime"/>
            <column name="location_id" type="int"/>
            <column name="description" type="varchar(1024)"/>
            <column name="encounter_id" type="int"/>
            <column name="order_id" type="int"/>
            <column name="part_of" type="INT"/>
            <column name="owner_id" type="INT"/>
            <column name="uuid" type="CHAR(38)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="creator" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="date_created" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="changed_by" type="INT"/>
            <column name="date_changed" type="DATETIME"/>
            <column name="voided" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="voided_by" type="INT"/>
            <column name="date_voided" type="DATETIME"/>
            <column name="void_reason" type="VARCHAR(255)"/>
        </createTable>

        <addForeignKeyConstraint constraintName="service_task_patient_id_patient_fk"
                baseTableName="service_task"  baseColumnNames="patient_id"
                referencedTableName="patient" referencedColumnNames="patient_id"/>
        <addForeignKeyConstraint constraintName="service_task_task_code_concept_fk"
                                 baseTableName="service_task" baseColumnNames="task_code"
                                 referencedTableName="concept" referencedColumnNames="concept_id"/>
        <addForeignKeyConstraint constraintName="service_task_owner_id_provider_fk"
                                 baseTableName="service_task" baseColumnNames="owner_id"
                                 referencedTableName="provider" referencedColumnNames="provider_id"/>
        <addForeignKeyConstraint constraintName="service_task_order_id_order_fk"
                                 baseTableName="service_task" baseColumnNames="order_id"
                                 referencedTableName="orders" referencedColumnNames="order_id"/>
        <addForeignKeyConstraint constraintName="service_task_location_id_location_fk"
                                 baseTableName="service_task" baseColumnNames="location_id"
                                 referencedTableName="location" referencedColumnNames="location_id"/>
        <addForeignKeyConstraint constraintName="service_task_encounter_id_encounter_fk"
                                 baseTableName="service_task" baseColumnNames="encounter_id"
                                 referencedTableName="encounter" referencedColumnNames="encounter_id"/>
    </changeSet>

    <changeSet  id="create_service_task_index_part_of_202526121900" author="Angshu">
        <createIndex indexName="ris_task_part_of_task_idx" tableName="service_task">
            <column name="part_of"/>
        </createIndex>
    </changeSet>

    <changeSet id="add_business_status_column_202602171945" author="Jameela|Kousalya">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="service_task" columnName="business_status"/>
            </not>
        </preConditions>

        <addColumn tableName="service_task">
            <column name="business_status" type="int"/>
        </addColumn>

        <addForeignKeyConstraint constraintName="service_task_business_status_concept_fk"
                                 baseTableName="service_task" baseColumnNames="business_status"
                                 referencedTableName="concept" referencedColumnNames="concept_id"/>
    </changeSet>

    <changeSet id="create_service_task_input_table_202606151000" author="Rahul">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="service_task_input"/>
            </not>
        </preConditions>

        <createTable tableName="service_task_input">
            <column name="service_task_input_id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_service_task_input"/>
            </column>
            <column name="service_task_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="input_type" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="value_string" type="VARCHAR(255)"/>
            <column name="uuid" type="CHAR(38)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="creator" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="date_created" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="changed_by" type="INT"/>
            <column name="date_changed" type="DATETIME"/>
            <column name="voided" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="voided_by" type="INT"/>
            <column name="date_voided" type="DATETIME"/>
            <column name="void_reason" type="VARCHAR(255)"/>
        </createTable>

        <addForeignKeyConstraint constraintName="service_task_input_task_fk"
                                 baseTableName="service_task_input" baseColumnNames="service_task_id"
                                 referencedTableName="service_task" referencedColumnNames="service_task_id"/>
        <addForeignKeyConstraint constraintName="service_task_input_type_concept_fk"
                                 baseTableName="service_task_input" baseColumnNames="input_type"
                                 referencedTableName="concept" referencedColumnNames="concept_id"/>
        <addForeignKeyConstraint constraintName="service_task_input_creator_user_fk"
                                 baseTableName="service_task_input" baseColumnNames="creator"
                                 referencedTableName="users" referencedColumnNames="user_id"/>
        <addForeignKeyConstraint constraintName="service_task_input_voided_by_user_fk"
                                 baseTableName="service_task_input" baseColumnNames="voided_by"
                                 referencedTableName="users" referencedColumnNames="user_id"/>
        <addForeignKeyConstraint constraintName="service_task_input_changed_by_user_fk"
                                 baseTableName="service_task_input" baseColumnNames="changed_by"
                                 referencedTableName="users" referencedColumnNames="user_id"/>
    </changeSet>

    <changeSet id="create_service_task_input_index_service_task_id_202606151001" author="Rahul">
        <createIndex indexName="ris_task_input_service_task_idx" tableName="service_task_input">
            <column name="service_task_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="add_task_name_column_202611021609" author="Angshu">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="service_task" columnName="name"/>
            </not>
        </preConditions>
        <addColumn tableName="service_task">
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
